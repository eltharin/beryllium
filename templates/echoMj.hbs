<div data-scene="{{scene}}" class="echo_mj cases-container echo">
    <div class="cases-controls">
        <span title="{{localize "beryllium.echomj.enleve"}}" data-action="removeEcho"><span class="moins"></span></span>
        <label>{{localize "beryllium.echomj.label"}} : {{value}}</label>
        <span title="{{localize "beryllium.echomj.ajout"}}" data-action="addEcho"><span class="plus"></span></span>
    </div>
    <div class="values">
        {{#times value}}
            <span class="active">
            </span>
        {{/times}}
    </div>

</div>