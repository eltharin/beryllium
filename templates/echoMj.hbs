<div data-scene="{{scene}}" class="echo_mj cases-container echo">
    <div class="controls">
        <span title="{{localize "beryllium.echomj.enleve"}}"><button data-action="removeEcho">-</button></span>
        <label>{{localize "beryllium.echomj.label"}} : {{value}}</label>
        <span title="{{localize "beryllium.echomj.ajout"}}"><button data-action="addEcho">+</button></span>
    </div>
    <div class="values">
        {{#times value}}
            <span>
                <svg  class="active" width="24" height="24" viewBox="0 0 1792 1792" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1664 416v960q0 119-84.5 203.5T1376 1664H416q-119 0-203.5-84.5T128 1376V416q0-119 84.5-203.5T416 128h960q119 0 203.5 84.5T1664 416z"/>
                </svg>
            </span>
        {{/times}}
    </div>

</div>