<div class="sheet beryllium item-sheet">
    <div class="multicol">
        <div class="image">
            <img data-action="editImage" data-edit="img" src="{{document.img}}" alt="Photo de {{document.name}}" />
        </div>
        <div>
            <div >
                <label>{{localize "beryllium.itemsheet.common.nom"}}</label>
                <div>{{ fieldOrInput "name" class="pj-sheet-input" value=document.name }}</div>
            </div>

            <div>
                <label>{{localize "beryllium.itemsheet.common.prix"}}</label>
                <div class="multicol">
                    <label>{{localize "beryllium.bourse.couronne.label"}}</label>
                    <div>{{ fieldOrInput "system.prix.couronne" type="number" class="pj-sheet-input" }}</div>

                    <label>{{localize "beryllium.bourse.eclat.label"}}</label>
                    <div>{{ fieldOrInput "system.prix.eclat" type="number" class="pj-sheet-input" }}</div>

                    <label>{{localize "beryllium.bourse.fragment.label"}}</label>
                    <div>{{ fieldOrInput "system.prix.fragment" type="number" class="pj-sheet-input" }}</div>
                </div>
            </div>
            
            <div class="field">
                <label>{{localize "beryllium.itemsheet.arme.categorie"}}</label>
                <div>{{ fieldOrInput "system.categorie" class="pj-sheet-input" }}</div>
            </div>
                 
            <div class="field">
                <label>{{localize "beryllium.itemsheet.arme.degat"}}</label>
                <div>{{ fieldOrInput "system.degat" class="pj-sheet-input" }}</div>
            </div>
            
            <div class="field">
                <label>{{localize "beryllium.itemsheet.arme.portee"}}</label>
                <div>{{ fieldOrInput "system.portee" class="pj-sheet-input" }}</div>
            </div>
            
            <div class="field">
                <label>{{localize "beryllium.itemsheet.arme.special"}}</label>
                <div>{{ fieldOrInput "system.special" class="pj-sheet-input" }}</div>
            </div>
        </div>
    </div>
</div>