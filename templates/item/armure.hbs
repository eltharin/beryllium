<div class="sheet beryllium item-sheet">
    <div class="multicol">
        <div class="image">
            <img data-action="editImage" data-edit="img" src="{{document.img}}" alt="Photo de {{document.name}}" />
        </div>
        <div>
            <div >
                <label>{{localize "beryllium.itemsheet.common.nom"}}</label>
                <input type="text" name="name" value="{{document.name}}"/>
            </div>

            {{#if document.actor}}
            <div >
                <label>{{localize "beryllium.itemsheet.armure.isequipe"}}</label>
                <input type="checkbox" name="system.isEquipe" {{#if document.system.isEquipe }}checked="checked"{{/if}}/>
            </div>
            {{/if }}
            <div>
                <label>{{localize "beryllium.itemsheet.common.prix"}}</label>
                <div class="multicol">
                    <label>{{localize "beryllium.bourse.couronne.label"}}</label>
                    <input type="text" name="system.prix.couronne" value="{{document.system.prix.couronne}}"/>

                    <label>{{localize "beryllium.bourse.eclat.label"}}</label>
                    <input type="text" name="system.prix.eclat" value="{{document.system.prix.eclat}}"/>

                    <label>{{localize "beryllium.bourse.fragment.label"}}</label>
                    <input type="text" name="system.prix.fragment" value="{{document.system.prix.fragment}}"/>
                </div>
            </div>
            
            <div >
                <label>{{localize "beryllium.itemsheet.armure.type"}}</label>
                <input type="text" name="system.type" value="{{document.system.type}}"/>
            </div>

            <div>
                <div >
                    <label>{{localize "beryllium.itemsheet.armure.reductionDegat.combat"}}</label>
                    <input type="number" name="system.reductionDegat.combat" value="{{document.system.reductionDegat.combat}}"/>
                </div>
                            
                <div >
                    <label>{{localize "beryllium.itemsheet.armure.reductionDegat.physique"}}</label>
                    <input type="number" name="system.reductionDegat.physique" value="{{document.system.reductionDegat.physique}}"/>
                </div>
                            
                <div >
                    <label>{{localize "beryllium.itemsheet.armure.reductionDegat.magie"}}</label>
                    <input type="number" name="system.reductionDegat.magie" value="{{document.system.reductionDegat.magie}}"/>
                </div>
                            
                <div >
                    <label>{{localize "beryllium.itemsheet.armure.reductionDegat.volonte"}}</label>
                    <input type="number" name="system.reductionDegat.volonte" value="{{document.system.reductionDegat.volonte}}"/>
                </div>
            </div>

            <div>
                <div >
                    <label>{{localize "beryllium.itemsheet.armure.bonusDefense.combat"}}</label>
                    <input type="number" name="system.bonusDefense.combat" value="{{document.system.bonusDefense.combat}}"/>
                </div>

                <div >
                    <label>{{localize "beryllium.itemsheet.armure.bonusDefense.physique"}}</label>
                    <input type="number" name="system.bonusDefense.physique" value="{{document.system.bonusDefense.physique}}"/>
                </div>

                <div >
                    <label>{{localize "beryllium.itemsheet.armure.bonusDefense.magie"}}</label>
                    <input type="number" name="system.bonusDefense.magie" value="{{document.system.bonusDefense.magie}}"/>
                </div>

                <div >
                    <label>{{localize "beryllium.itemsheet.armure.bonusDefense.volonte"}}</label>
                    <input type="number" name="system.bonusDefense.volonte" value="{{document.system.bonusDefense.volonte}}"/>
                </div>
            </div>       

            <div >
                <label>{{localize "beryllium.itemsheet.armure.inconvenient"}}</label>
                <input type="text" name="system.inconvenient" value="{{document.system.inconvenient}}"/>
            </div>
        </div>
    </div>
</div>