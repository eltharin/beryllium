<div class="dice-roll" data-action="expandRoll">
    <div class="dice-result">
        <div class="dice-formula">{{title}}</div>
        {{{tooltip}}}
        <div class="dice-formula">total : {{total}}</div>
        <h4 class="dice-total">total : {{totalText}} = {{totalValue}}</h4>
        
        <div class="dice-formula">{{localize "beryllium.RollDifficulte.label"}} : {{seuil}}</div>
        {{# if resultat }}
        <h4 class="dice-total">{{localize "beryllium.rolldice.result.reussite" }}</h4>
        <button data-action="sortieSurchauffe">{{localize "beryllium.messages.surchauffe.valideSortie" }}</button>
        {{else}}
        <h4 class="dice-total">{{localize "beryllium.rolldice.result.echec" }}</h4>
        {{/if}}
    </div>
</div>
