<div class="dice-roll" data-action="expandRoll">
    <div class="dice-result">
        <div class="dice-formula">
            <div>{{localize "beryllium.attaquedefense.attaque.carac"}} {{localize (concat "beryllium.pjsheet.competences." competenceLabel)}}</div>
            <div >{{localize (concat "beryllium.attaquedefense.attaque.item." item.type) item=item.name}}{{#if (eq item.type "arme")}} (+{{item.degats}}){{/if}}</div>
        </div>
        {{{tooltip}}}
        <div class="dice-formula">{{localize "beryllium.roll.common.total"}} : {{total}}</div>
        <h4 class="dice-total">{{localize "beryllium.roll.common.total"}} : {{totalText}} = {{totalValue}}</h4>
        <h4>{{localize "beryllium.attaquedefense.attaque.cibles"}}</h4>
        {{#each targets as |target|}}
        <div class="target" data-hover="showTarget" data-tokenUuid="{{target.uuid}}">{{target.name}} : {{#if (eq target.result null)}}{{localize "beryllium.attaquedefense.attaque.resultat.attente"}}{{else}}{{target.result}}{{/if}}</div>
        {{/each}}
        {{#if canDefendre}}
            <button data-action="defense">{{localize "beryllium.attaquedefense.attaque.defendrebtn"}}</button>
        {{/if}}
    </div>
</div>
