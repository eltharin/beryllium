<section
  class='tab {{tab.cssClass}}'
  data-group='primary'
  data-tab='magie'
>
  <div class="pj-sheet-cat fields-container magie">
    <div class="multifields">
      <div class="field">
          <label>{{localize "beryllium.pjsheet.magie.affinite.label"}}</label>
          <div>
            {{#fieldOrInput "system.magie.affinite" class="pj-sheet-input" value=system.magie.affiniteobj.name }}
              <select name="system.magie.affinite">
                  <option value="">{{localize "beryllium.pjsheet.magie.affinite.select"}}</option>
                  {{#each ../listes.magies.list as |mag| }}
                      <option value="{{mag.id}}" {{#if (eq mag.id ../../system.magie.affinite) }}selected{{/if}}>{{mag.name}}</option>
                  {{/each}}
              </select>
            {{/fieldOrInput}}
          </div>
      </div>

      <div class="field">
          <label>{{localize "beryllium.pjsheet.magie.oppose.label"}}</label>
          <div><span class="field-value">{{ system.magie.oppose.name }}</span></div>
      </div>
    </div>
    <div class="multifields">
      <div class="field">
          <label>{{localize "beryllium.pjsheet.magie.tradition.label"}}</label>
          <div>{{ fieldOrInput "system.aspects.tradition" class="pj-sheet-input" }}</div>
      </div>
      <div class="field">
          <label>{{localize "beryllium.pjsheet.magie.seuil.label"}}</label>
          <div><span class="field-value">{{ system.magie.seuil }}</span></div>
      </div>
    </div>
  </div>

  <h2>
    {{localize "beryllium.pjsheet.magie.sort.listLabel"}}
    <span title="{{localize "beryllium.pjsheet.magie.sort.ajout"}}"><a class="sort create" data-action="addItem" data-type="sort"><i class="fas fa-plus"></i></a></span>
  </h2>
  <div class="inventory-section">
    {{#each (array "default" "custom") as |type| }}
      {{#if (eq type "default")}}
        <div class="titres">
          <div class="item flexrow" >
            <div class="" >{{ localize "beryllium.pjsheet.combat.sort.titre" }}</div>
            <div class="infos flexrow">
              <div>
                  {{ localize "beryllium.pjsheet.combat.sort.niveau" }}
              </div>
              <div>
                  {{ localize "beryllium.pjsheet.combat.sort.coutFletrine" }}
              </div>
              <div>
                  {{ localize "beryllium.pjsheet.combat.sort.portee" }}
              </div>
              <div class="controls">
                {{ localize "beryllium.pjsheet.combat.sort.voireffet" }}
              </div>
            </div>
            <div class="controls">
              {{ localize "beryllium.pjsheet.combat.sort.actions" }}
            </div>
          </div>
        </div>
      {{/if}}


      <div class="sort">
        {{#each (lookup ../sorts type) as |sort|}}
          <div class="item" data-itemid="{{sort._id}}">
            <div class="flexrow" data-itemid="{{sort._id}}">
              <div class="clickable" data-action="attaque" data-competence="magie" data-itemid="{{sort._id}}">{{sort.name}}</div>
              <div class="infos flexrow">
                <div>
                    {{sort.system.level}}
                </div>
                <div>
                    {{sort.system.coutFletrine}}
                </div>
                <div>
                    {{sort.system.portee}}
                </div>
                <div class="controls">
                  {{#if sort.system.effet}}
                    <a data-action="toggle" data-toggle="sortspecial_{{sort._id}}" title="{{localize "beryllium.pjsheet.combat.magie.effet"}}"><i class="fas fa-eye"></i></a>
                  {{/if}}
                </div>
              </div>
              <div class="controls">
                <a data-action="editItem" data-type="sort" data-itemId="{{sort._id}}" title="{{localize "beryllium.pjsheet.magie.sort.edit"}}"><i class="fas fa-edit"></i></a>
                {{#if (eq type "custom")}}
                  <a data-action="deleteItem" data-type="sort" data-itemId="{{sort._id}}" title="{{localize "beryllium.pjsheet.magie.sort.delete"}}"><i class="fas fa-trash"></i></a>
                {{/if}}
              </div>
            </div>
            {{#if sort.system.effet}}
              <div class="toggleable flexrow" data-toggle_section="sortspecial_{{sort._id}}">
                <div class="infos">
                  {{sort.system.effet}}
                </div>
              </div>
            {{/if}}
          </div>
        {{/each}}
      </div>  
    {{/each}}
  </div>

</section>