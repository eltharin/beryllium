<section
  class='tab {{tab.cssClass}}'
  data-group='primary'
  data-tab='magie'
>
  <div class="pj-sheet-cat fields-container magie">
    <div class="multicol-fields">
      <div class="field">
          <label>{{localize "beryllium.pjsheet.magie.affinite.label"}}</label>
          <div>
            {{#fieldOrInput "system.magie.affinite" class="pj-sheet-input" value=system.magie.affiniteobj.name }}
              <select name="system.magie.affinite">
                  <option value="">{{localize "beryllium.pjsheet.magie.affinite.select"}}</option>
                  {{#each ../listes.magies.list as |mag| }}
                      <option value="{{mag.id}}" {{#if (eq mag.id ../../system.magie.affinite) }}selected{{/if}}>{{mag.name}}</option>
                  {{/each}}
              </select>
            {{/fieldOrInput}}
          </div>
      </div>

      <div class="field">
          <label>{{localize "beryllium.pjsheet.magie.oppose.label"}}</label>
          <div><span class="field-value">{{ system.magie.oppose.name }}</span></div>
      </div>
    
  

  
    
      <div class="field">
          <label>{{localize "beryllium.pjsheet.magie.tradition.label"}}</label>
          <div>{{ fieldOrInput "system.aspects.tradition" class="pj-sheet-input" }}</div>
      </div>
      <div class="field">
          <label>{{localize "beryllium.pjsheet.magie.seuil.label"}}</label>
          <div><span class="field-value">{{ system.magie.seuil }}</span></div>
      </div>
    </div>
  </div>

  <div class="inventory-section">
    <h3>{{localize "beryllium.pjsheet.magie.sort.listLabel"}}</h3>
    <div class="sorts-list">
      {{#each sorts.default as |sort|}}
          <div class="item flexrow" data-item-id="{{sort._id}}">
            <div class="clickable" data-action="attaque" data-competence="magie">{{sort.name}}</div>
            <div class="controls"> </div>
          </div>
      {{/each}}
      </div>

      <div class="sort create" data-action="addItem" data-type="sort">
        <span><a><i class="fas fa-plus"></i> {{localize "beryllium.pjsheet.magie.sort.ajout"}}</a></span>
      </div>

      <div class="sorts-list"> 
      {{#each sorts.custom as |sort|}}
          <div class="item flexrow" data-item-id="{{sort._id}}">
            <div class="clickable" data-action="attaque" data-competence="magie"><a>{{sort.name}}</a></div>
            <div class="controls">
              <a data-action="editItem" data-type="sort" data-itemId="{{sort._id}}" title="{{localize "beryllium.pjsheet.magie.sort.edit"}}"><i class="fas fa-edit"></i></a>
              <a data-action="deleteItem" data-type="sort" data-itemId="{{sort._id}}" title="{{localize "beryllium.pjsheet.magie.sort.delete"}}"><i class="fas fa-trash"></i></a>
            </div>
          </div>
      {{/each}}
    </div>  
  </div>

</section>