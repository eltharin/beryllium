<section
  class='tab {{tab.cssClass}}'
  data-group='primary'
  data-tab='combat'
>
  <div class="pj-sheet-cat combat">


    <div class="inventory-section">
      <h2>
        {{localize "beryllium.pjsheet.combat.arme.label"}}
        {{#if (not isVerrou) }}
          <span title="{{localize "beryllium.pjsheet.combat.arme.ajout"}}"><a class="arme create" data-action="addItem" data-type="arme"><i class="fas fa-plus"></i></a></span>
        {{/if}}
      </h2>

      {{#each (array "default" "custom") as |type| }}
        {{#if (eq type "default")}}
          <div class="arme titres">
            <div class="item flexrow" >
              <div class="" >{{ localize "beryllium.pjsheet.combat.arme.titre" }}</div>
              <div class="infos flexrow">
                <div>
                    {{ localize "beryllium.pjsheet.combat.arme.portee" }}
                </div>
                <div>
                    {{ localize "beryllium.pjsheet.combat.arme.degat" }}
                </div>
                <div class="controls">
                  {{ localize "beryllium.pjsheet.combat.arme.voirspecial" }}
                </div>
              </div>
              <div class="controls">
                {{ localize "beryllium.pjsheet.combat.arme.actions" }}
              </div>
            </div>
          </div>
        {{/if}}


        <div class="arme">
          {{#each (lookup ../armes type) as |arme|}}
            <div class="item flexrow" data-itemid="{{arme._id}}">
              <div class="clickable" data-action="attaque" data-competence="combat" data-itemid="{{arme._id}}">{{arme.name}}</div>
              <div class="infos flexrow">
                <div>
                    {{arme.system.portee}}
                </div>
                <div>
                    {{arme.system.degat}}
                </div>
                <div class="controls">
                  {{#if arme.system.special}}
                    <a data-action="toggleSpecial" title="{{localize "beryllium.pjsheet.combat.arme.delete"}}"><i class="fas fa-eye"></i></a>
                  {{/if}}
                </div>
              </div>
              <div class="controls">
                <a data-action="editItem" data-type="arme" data-itemId="{{arme._id}}" title="{{localize "beryllium.pjsheet.combat.arme.edit"}}"><i class="fas fa-edit"></i></a>
                {{#if (eq type "custom")}}
                  <a data-action="deleteItem" data-type="arme" data-itemid="{{arme._id}}" title="{{localize "beryllium.pjsheet.combat.arme.delete"}}"><i class="fas fa-trash"></i></a>
                {{/if}}
              </div>
            </div>
            {{#if arme.system.special}}
              <div class="item toggleable flexrow" data-itemid="{{arme._id}}">
                <div class="infos">
                  {{arme.system.special}}
                </div>
              </div>
            {{/if}}
          {{/each}}
        </div>  
      {{/each}}
    </div>

    <div class="inventory-section">
      <h2>
        {{localize "beryllium.pjsheet.combat.armure.label"}}
        {{#if (not isVerrou) }}
          <span title="{{localize "beryllium.pjsheet.combat.armure.ajout"}}"><a class="armure create" data-action="addItem" data-type="armure"><i class="fas fa-plus"></i></a></span>
        {{/if}}
      </h2>
        <div class="armure-list"> 
        {{#each armures as |armure|}}
            <div class="item flexrow" data-item-id="{{armure._id}}">
              <div >{{armure.name}}</div>
              <div class="controls">
                {{#if armure.system.isEquipe}}
                <a data-action="desequipeArmure" data-type="armure" data-itemid="{{armure._id}}" title="{{localize "beryllium.pjsheet.combat.armure.desequipe"}}"><i class="fas fa-minus"></i></a>
                {{else}}
                <a data-action="equipeArmure" data-type="armure" data-itemid="{{armure._id}}" title="{{localize "beryllium.pjsheet.combat.armure.equipe"}}"><i class="fas fa-plus"></i></a>
                {{/if}}
                <a data-action="editItem" data-type="armure" data-itemid="{{armure._id}}" title="{{localize "beryllium.pjsheet.combat.armure.edit"}}"><i class="fas fa-edit"></i></a>
                <a data-action="deleteItem" data-type="armure" data-itemid="{{armure._id}}" title="{{localize "beryllium.pjsheet.combat.armure.delete"}}"><i class="fas fa-trash"></i></a>
              </div>
            </div>
        {{/each}}
      </div>  
    </div>

  </div>
</section>