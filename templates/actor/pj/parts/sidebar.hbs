    </div>
    <div class="values">
        {{#times oubli.valcheck}}
            <span class="active"></span>
        {{/times}}
        {{#times oubli.valnoncheck }}
            <span></span>
        {{/times}}
    </div>
</div>

<div class="separation"></div>

