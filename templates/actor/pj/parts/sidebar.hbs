<div class="image">
    <img data-action="editImage" data-edit="img" src="{{document.img}}" alt="Photo de {{document.name}}" />
</div>

<div class="cases-container stress">
    <div class="cases-controls">
        <span data-action="addRemove" data-item="stress" data-sens="-"><span class="moins"></span></span>
        <label>{{localize "beryllium.pjsheet.stress.label"}}</label>
        <span data-action="addRemove" data-item="stress" data-sens="+"><span class="plus"></span></span>
    </div>
    <div class="values">
        {{#times stress.valcheck}}
            <span class="active"></span>
        {{/times}}
        {{#times stress.valnoncheck }}
            <span></span>
        {{/times}}
    </div>
</div>

<div class="separation"></div>

{{#if (gt system.competences.magie.value 0) }}
<div class="cases-container fletrine">
    <div class="etats">
        <label class="resonnance {{#if system.magie.isResonnance}}active{{/if}}">{{localize "beryllium.pjsheet.magie.resonnance"}}</label>
        <label class="dissonnance {{#if system.magie.isDissonnance}}active{{/if}}">{{localize "beryllium.pjsheet.magie.dissonnance"}}</label>
        <label class="surchauffe clicdice {{#if system.magie.isSurchauffe}}active{{/if}}" data-action="jetSortieSurchauffe">{{localize "beryllium.pjsheet.magie.surchauffe"}}</label>
    </div>

    <div class="cases-controls">
        <span data-action="addRemove" data-item="magie.fletrine" data-sens="-"><span class="moins"></span></span>
        <label>{{localize "beryllium.pjsheet.fletrine.label"}}</label>
        <span data-action="addRemove" data-item="magie.fletrine" data-sens="+"><span class="plus"></span></span>
    </div>

    {{#each fletrine as |flet|}}
    <div class="niveau">
        <label class="{{#if flet.isMax}}fletrine_niveau_max{{/if}}">{{flet.label}}</label>
        <div class="values">
        {{#times flet.nbCheck}}
            <span class="active"></span>
        {{/times}}
        {{#times flet.nbNoncheck }}
            <span></span>
        {{/times}}
        </div>
    </div>
    {{/each}}
</div>
{{/if}}

<div class="separation"></div>

