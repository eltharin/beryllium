<section
  class='tab {{tab.cssClass}}'
  data-group='primary'
  data-tab='equipements'
>
  <div class="pj-sheet-cat equipements">
  <div class="inventory-section">
    <h2>{{localize "beryllium.pjsheet.objet.titre"}}</h2>

        <div class="argent">
        <a data-action="depense" title="{{localize "beryllium.pjsheet.bourse.creerdepense"}}"><i class="fas fa-coins"></i></a>
            <label>{{localize "beryllium.bourse.couronne.label"}}</label>
            <input type="text" name="system.bourse.couronne" value="{{system.bourse.couronne}}" class="pj-sheet-input" placeholder=""/>

            <label>{{localize "beryllium.bourse.eclat.label"}}</label>
            <input type="text" name="system.bourse.eclat" value="{{system.bourse.eclat}}" class="pj-sheet-input" placeholder=""/>
            <label>{{localize "beryllium.bourse.fragment.label"}}</label>
            <input type="text" name="system.bourse.fragment" value="{{system.bourse.fragment}}" class="pj-sheet-input" placeholder=""/>
    </div>
    
      <div class="objet create" data-action="addItem" data-type="objet">
        <a><i class="fas fa-plus"></i> {{localize "beryllium.pjsheet.objet.ajout"}}</a>
      </div>

      <div class="objet-list"> 
      {{#each items as |armure|}}
          <div class="item flexrow" data-item-id="{{armure._id}}">
            <div >{{armure.name}}</div>
            <div class="controls">
              <a data-action="editItem" data-type="item" data-itemId="{{armure._id}}" title="{{localize "beryllium.pjsheet.combat.armure.edit"}}"><i class="fas fa-edit"></i></a>
              <a data-action="deleteItem" data-type="item" data-itemId="{{armure._id}}" title="{{localize "beryllium.pjsheet.combat.armure.delete"}}"><i class="fas fa-trash"></i></a>
            </div>
          </div>
      {{/each}}
    </div>  
  </div>
  </div>
</section>