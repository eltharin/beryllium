<section
  class='tab {{tab.cssClass}}'
  data-group='primary'
  data-tab='heritage'
>
  <div class="pj-sheet-cat fields-container heritage">

    <div class="field">
        <label>{{localize "beryllium.pjsheet.culture.label"}}</label>
        <div><!---
          -->{{#fieldOrInput "system.culture" class="pj-sheet-input" value=system.cultureobj.name }}
          <select name="system.culture">
              <option value="">{{localize "beryllium.pjsheet.culture.select"}}</option>
              {{#each ../culture.list as |cult| }}
                  <option value="{{cult.id}}" {{#if (eq cult.id ../../system.culture) }}selected{{/if}}>{{cult.name}}</option>
              {{/each}}
          </select>
          {{/fieldOrInput}}<!---
        --></div>
    </div>


    <div class="field heritage">
        <label>{{localize "beryllium.pjsheet.heritage.aspect"}}</label>
        <div>{{ fieldOrInput "system.heritage.aspect" class="pj-sheet-input" }}</div>
    </div>
    <div class="field heritage privilege">
        <label>{{localize "beryllium.pjsheet.heritage.privilege"}}</label>
        
        <div>
          {{#each system.cultureobj.privileges as |privilege|}}
            <div class="notfield">
              <div class="title">{{ privilege.titre }}
                {{#with (lookup ../system.heritage.utilisationPrivilege @key) as |util| }}
                  <span class="util clickable" 
                  {{#if ../../isVerrou}}
                    title="{{localize "beryllium.pjsheet.heritage.useprivilege.use"}}" data-action="usePrivilege"
                  {{else}}
                    title="{{localize "beryllium.pjsheet.heritage.useprivilege.manage"}}" data-action="managePrivilege"
                  {{/if}}
                   data-privilegeid="{{@key}}"> ({{localize "beryllium.pjsheet.heritage.useprivilege.label"}}{{ util.value }}/{{ util.max }})</span>
                {{/with }}
              </div>
              <div class="legend">{{ privilege.description }}</div>
            </div>
          {{/each }}
        </div>
    </div>
    <div class="field heritage">
        <label>{{localize "beryllium.pjsheet.heritage.faiblesse"}}</label>
        <div>
          {{#each system.cultureobj.faiblesses as |faiblesse|}}
            <div class="notfield">
              <span class="title">{{ faiblesse.description }}</span>
            </div>
          {{/each }}
        </div>
    </div>
    <div class="field heritage">
        <label>{{localize "beryllium.pjsheet.heritage.specialisation"}}</label>
        <div>
          {{#each system.cultureobj.specialisations as |specialisation|}}
            <div class="notfield">
              <div class="title">{{ specialisation.titre }}</div>
              <div class="legend">{{ specialisation.base }} : {{ specialisation.bonus }}</div>
            </div>
          {{/each }}
        </div>
    </div>

  </div>
</section>