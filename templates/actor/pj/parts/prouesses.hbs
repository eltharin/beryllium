<section
  class='tab {{tab.cssClass}}'
  data-group='primary'
  data-tab='prouesses'
>
  <div class="pj-sheet-cat prouesses">
    {{#times system.prouesses.max }}
      <div class="prouesse" data-prouesse="{{index}}">
        {{#with (lookup system.prouesses.values index) as |prouesse|}}
          <div class="multifields">
            <div class="field">
              <label data-action="utilisationProuesse" data-prouesseId="{{../index}}">{{localize "beryllium.pjsheet.prouesses.label" num=../index1 }}</label>
              <div>{{ fieldOrInput (concat "system.prouesses.values." ../index ".nom") value=prouesse.nom class="pj-sheet-input" }}</div>
            </div>
            <div class="prouesse_actif_div">
              {{#fieldOrInput (concat "system.prouesses.values." ../index ".isActif") value=(ternary  prouesse.isActif  (localize "beryllium.pjsheet.prouesses.actif") (localize "beryllium.pjsheet.prouesses.passif")) class="pj-sheet-input" }}
                <select name="system.prouesses.values.{{../../index}}.isActif">
                  <option value="true" {{#if prouesse.isActif }}selected="selected"{{/if}}>Actif</option>
                  <option value="false" {{#if (not prouesse.isActif) }}selected="selected"{{/if}}>Passif</option>
                </select>
              {{/fieldOrInput}}
            </div>
          </div>
          <div class="field">
            <label>{{localize "beryllium.pjsheet.prouesses.effet"}}</label>
            <div>
              {{#fieldOrInput (concat "system.prouesses.values." ../index ".effet") value=prouesse.effet class="pj-sheet-input" }}
                <textarea name="system.prouesses.values.{{../../index}}.effet" rows="2" class="pj-sheet-input" placeholder="">{{prouesse.effet}}</textarea>
              {{/fieldOrInput}}
            </div>
          </div>
        {{/with}}
      </div>
    {{/times}}
  </div>
</section>