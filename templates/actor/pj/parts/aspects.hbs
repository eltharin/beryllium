<section
  class='tab {{tab.cssClass}}'
  data-group='primary'
  data-tab='aspects'
>
    <div class="pj-sheet-cat fields-container aspects">
        <div class="field">
            <label>{{localize "beryllium.pjsheet.aspects.concept"}}</label>
            <div>{{ fieldOrInput "system.aspects.concept" class="pj-sheet-input" }}</div>
        </div>
        <div class="field">
            <label>{{localize "beryllium.pjsheet.aspects.probleme"}}</label>
            <div>{{ fieldOrInput "system.aspects.probleme" class="pj-sheet-input" }}</div>
        </div>
        <div class="field">
            <label>{{localize "beryllium.pjsheet.aspects.lien"}}</label>
            <div>{{ fieldOrInput "system.aspects.lien" class="pj-sheet-input" }}</div>
        </div>
        <div class="field">
            <label>{{localize "beryllium.pjsheet.aspects.methode"}}</label>
            <div>{{ fieldOrInput "system.aspects.methode" class="pj-sheet-input" }}</div>
        </div>
    </div>

    <div class="pj-sheet-cat fields-container aspects">
      <h2>
        <span>{{localize "beryllium.pjsheet.aspects.temporaires.label"}}</span>
        {{#if (not isVerrou) }}
            <span class="clickable" data-action="addAspect" title="{{localize "beryllium.pjsheet.aspects.temporaires.ajout"}}"><a><i class="fas fa-plus"></i></a></span>
        {{/if}}
      </h2>
        {{#each system.aspects.temporaires}}
            <div class="field">
                <div>{{ fieldOrInput (concat "system.aspects.temporaires." @index ".nom") value=this.nom class="pj-sheet-input" }}</div>
                {{#if (not ../isVerrou) }}
                    <span>
                        <a data-action="deleteAspect" data-itemid="{{@index}}" title="{{localize "beryllium.pjsheet.combat.armure.delete"}}"><i class="fas fa-trash"></i></a>
                    </span>
                {{/if}}
            </div>
        {{/each}}
    </div>
</section>