<div class="action field competence">
    <div>
        {{#if isVerrou }}
            <a data-action="deverouillage" title="{{localize "beryllium.pjsheet.repos.buttontitle"}}"><i class="fas fa-unlock"></i></a>
        {{else}}
            <a data-action="verouillage" title="{{localize "beryllium.pjsheet.repos.buttontitle"}}"><i class="fas fa-lock"></i></a>
        {{/if}}
    </div>
    <div><a data-action="repos" title="{{localize "beryllium.pjsheet.repos.buttontitle"}}"><i class="fas fa-tents"></i></a></div>
