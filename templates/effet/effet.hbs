<div class="sheet beryllium item-sheet">
    <div class="multicol">
        <div class="image">
            <img data-action="editImage" data-edit="img" src="{{document.img}}" alt="Photo de {{document.name}}" />
        </div>
        <div>
            <div class="field">
                <label>{{localize "beryllium.sheets.common.nom"}}</label>
                <div>{{ fieldOrInput "name" class="pj-sheet-input" value=document.name }}</div>
            </div>
            
            <div class="field">
                <label>{{localize "beryllium.sheets.effet.effet"}}</label>
                <div>{{ fieldOrInput "system.effet" class="pj-sheet-input" }}</div>
            </div>
                 
            
            
            <div class="field">
                <label>{{localize "beryllium.sheets.effet.condition"}}</label>
                <div>{{ fieldOrInput "system.condition" class="pj-sheet-input" }}</div>
            </div>
        </div>
    </div>
</div>